{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_ORIGIN": "http://192.168.100.33:4000" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_ORIGIN": "https://api.nous.mn" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_ORIGIN": "https://api.nous.mn" }
    }
  },
  "submit": {
    "production": {}
  }
}
