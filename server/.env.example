# MongoDB Atlas холболтын string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nous?retryWrites=true&w=majority

# JWT нууц түлхүүр — урт, санамсаргүй утга өг (production-д заавал сольж)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Server port
PORT=4000

# Frontend origin (CORS). Олон бол таслалаар: https://nous.mn,http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Reverse proxy-ийн hop тоо (rate limit бодит IP авахад). nginx ард = 1
TRUST_PROXY=1

# OTP илгээх Gmail. Production-д ЗААВАЛ — код API хариунд буцаахгүй.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Persistent image storage (production-д шаардлагатай)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@nous.mn

# Expo push (native app). Expo "enhanced push security" асаасан үед л хэрэгтэй.
EXPO_ACCESS_TOKEN=

# Log түвшин: fatal | error | warn | info | debug (default: info). Production log нь JSON мөр.
LOG_LEVEL=info

# Яаралтай үед л true: /uploads зургийг нэвтрэлтгүй нээнэ (default: false — зөвхөн эзэн/хос нь харна)
UPLOADS_PUBLIC=false
