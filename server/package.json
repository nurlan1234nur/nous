{
  "name": "nous-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "nous couples app — Express + MongoDB + Socket.IO backend",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "cleanup:legacy-images": "tsx src/cleanupLegacyImages.ts",
    "generate:vapid": "web-push generate-vapid-keys",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "battleships-engine": "^0.2.8",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.10",
    "socket.io": "^4.7.5",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.11",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^3.2.7"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "7.0.14"
    }
  }
}
